# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=change-me-to-a-secure-random-secret-key

# Database Configuration
# Local SQLite default: parking.db (or an absolute path)
# In production on Render/cloud with persistent disk, set DATABASE_PATH to the mounted volume path:
# e.g., DATABASE_PATH=/var/data/parking.db
DATABASE_PATH=parking.db
